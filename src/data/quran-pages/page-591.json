    },
    {
      "sura_no": 87,
      "sura_name_ar": "الأعلى",
      "sura_name_en": "Al-A‘lā",
      "type": "meccan",
      "starts_here": true
    }
  ],
  "ayahs": [
    {
      "sura_no": 86,
      "aya_no": 1,
      "aya_text": "وَالسَّمَآءِ وَالطَّارِقِ ١"
    },
    {
      "sura_no": 86,
      "aya_no": 2,
      "aya_text": "وَمَا أَدْرَيٰكَ مَا اَ۬لطَّارِقُ ٢"
    },
    {
      "sura_no": 86,
      "aya_no": 3,
      "aya_text": "اُ۬لنَّجْمُ اُ۬لثَّاقِبُ ٣"
    },
    {
      "sura_no": 86,
      "aya_no": 4,
      "aya_text": "إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ ٤"
    },
    {
      "sura_no": 86,
      "aya_no": 5,
      "aya_text": "فَلْيَنظُرِ اِ۬لْإِنسَٰنُ مِمَّ خُلِقَۖ ٥"
    },
    {
      "sura_no": 86,
      "aya_no": 6,
      "aya_text": "خُلِقَ مِن مَّآءٖ دَافِقٖ ٦"
    },
    {
      "sura_no": 86,
      "aya_no": 7,
      "aya_text": "يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ ٧"
    },
    {
      "sura_no": 86,
      "aya_no": 8,
      "aya_text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٞ ٨"
    },
    {
      "sura_no": 86,
      "aya_no": 9,
      "aya_text": "يَوْمَ تُبْلَى اَ۬لسَّرَآئِرُ ٩"
    },
    {
      "sura_no": 86,
      "aya_no": 10,
      "aya_text": "فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ ١٠"
    },
    {
      "sura_no": 86,
      "aya_no": 11,
      "aya_text": "وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ ١١"
    },
    {
      "sura_no": 86,
      "aya_no": 12,
      "aya_text": "وَالْأَرْضِ ذَاتِ اِ۬لصَّدْعِ ١٢"
    },
    {
      "sura_no": 86,
      "aya_no": 13,
      "aya_text": "إِنَّهُۥ لَقَوْلٞ فَصْلٞ ١٣"
    },
    {
      "sura_no": 86,
      "aya_no": 14,
      "aya_text": "وَمَا هُوَ بِالْهَزْلِۖ ١٤"
    },
    {
      "sura_no": 86,
      "aya_no": 15,
      "aya_text": "إِنَّهُمْ يَكِيدُونَ كَيْداٗ ١٥"
    },
    {
      "sura_no": 86,
      "aya_no": 16,
      "aya_text": "وَأَكِيدُ كَيْداٗۖ ١٦"
    },
    {
      "sura_no": 86,
      "aya_no": 17,
      "aya_text": "فَمَهِّلِ اِ۬لْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْداَۢۖ ١٧"
    },
    {
      "sura_no": 87,
      "aya_no": 1,
      "aya_text": "سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لْأَعْلَى ١"
    },
    {
      "sura_no": 87,
      "aya_no": 2,
      "aya_text": "اَ۬لذِے خَلَقَ فَسَوَّىٰ ٢"
    },
    {
      "sura_no": 87,
      "aya_no": 3,
      "aya_text": "وَالذِے قَدَّرَ فَهَدَىٰ ٣"
    },
    {
      "sura_no": 87,
      "aya_no": 4,
      "aya_text": "وَالذِے أَخْرَجَ اَ۬لْمَرْعَىٰ ٤"
    },
    {
      "sura_no": 87,
      "aya_no": 5,
      "aya_text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ ٥"
    },
    {
      "sura_no": 87,
      "aya_no": 6,
      "aya_text": "سَنُقْرِئُكَ فَلَا تَنسَىٰ ٦"
    },
    {
      "sura_no": 87,
      "aya_no": 7,
      "aya_text": "إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْفَىٰۖ ٧"
    },
    {
      "sura_no": 87,
      "aya_no": 8,
      "aya_text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ ٨"
    },
    {
      "sura_no": 87,
      "aya_no": 9,
      "aya_text": "فَذَكِّرْ إِن نَّفَعَتِ اِ۬لذِّكْرَىٰۖ ٩"
    },
    {
      "sura_no": 87,
      "aya_no": 10,
      "aya_text": "سَيَذَّكَّرُ مَنْ يَّخْشَىٰ ١٠"
    }
  ],
  "page_text": "وَالسَّمَآءِ وَالطَّارِقِ ١ وَمَا أَدْرَيٰكَ مَا اَ۬لطَّارِقُ ٢ اُ۬لنَّجْمُ اُ۬لثَّاقِبُ ٣ إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ ٤ فَلْيَنظُرِ اِ۬لْإِنسَٰنُ مِمَّ خُلِقَۖ ٥ خُلِقَ مِن مَّآءٖ دَافِقٖ ٦ يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ ٧ إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٞ ٨ يَوْمَ تُبْلَى اَ۬لسَّرَآئِرُ ٩ فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ ١٠ وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ ١١ وَالْأَرْضِ ذَاتِ اِ۬لصَّدْعِ ١٢ إِنَّهُۥ لَقَوْلٞ فَصْلٞ ١٣ وَمَا هُوَ بِالْهَزْلِۖ ١٤ إِنَّهُمْ يَكِيدُونَ كَيْداٗ ١٥ وَأَكِيدُ كَيْداٗۖ ١٦ فَمَهِّلِ اِ۬لْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْداَۢۖ ١٧ سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لْأَعْلَى ١ اَ۬لذِے خَلَقَ فَسَوَّىٰ ٢ وَالذِے قَدَّرَ فَهَدَىٰ ٣ وَالذِے أَخْرَجَ اَ۬لْمَرْعَىٰ ٤ فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ ٥ سَنُقْرِئُكَ فَلَا تَنسَىٰ ٦ إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْفَىٰۖ ٧ وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ ٨ فَذَكِّرْ إِن نَّفَعَتِ اِ۬لذِّكْرَىٰۖ ٩ سَيَذَّكَّرُ مَنْ يَّخْشَىٰ ١٠"
}