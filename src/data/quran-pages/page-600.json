  ],
  "ayahs": [
    {
      "sura_no": 100,
      "aya_no": 6,
      "aya_text": "إِنَّ اَ۬لْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦"
    },
    {
      "sura_no": 100,
      "aya_no": 7,
      "aya_text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧"
    },
    {
      "sura_no": 100,
      "aya_no": 8,
      "aya_text": "وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ ٨"
    },
    {
      "sura_no": 100,
      "aya_no": 9,
      "aya_text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ ٩"
    },
    {
      "sura_no": 100,
      "aya_no": 10,
      "aya_text": "وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ ١٠"
    },
    {
      "sura_no": 100,
      "aya_no": 11,
      "aya_text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٖ لَّخَبِيرُۢۖ ١١"
    },
    {
      "sura_no": 101,
      "aya_no": 1,
      "aya_text": "اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ ١"
    },
    {
      "sura_no": 101,
      "aya_no": 2,
      "aya_text": "وَمَا أَدْرَيٰكَ مَا اَ۬لْقَارِعَةُۖ ٢"
    },
    {
      "sura_no": 101,
      "aya_no": 3,
      "aya_text": "يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ ٣"
    },
    {
      "sura_no": 101,
      "aya_no": 4,
      "aya_text": "وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ ٤"
    },
    {
      "sura_no": 101,
      "aya_no": 5,
      "aya_text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ ٥"
    },
    {
      "sura_no": 101,
      "aya_no": 6,
      "aya_text": "فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖۖ ٦"
    },
    {
      "sura_no": 101,
      "aya_no": 7,
      "aya_text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ ٧"
    },
    {
      "sura_no": 101,
      "aya_no": 8,
      "aya_text": "فَأُمُّهُۥ هَاوِيَةٞۖ ٨"
    },
    {
      "sura_no": 101,
      "aya_no": 9,
      "aya_text": "وَمَا أَدْرَيٰكَ مَا هِيَهْۖ ٩"
    },
    {
      "sura_no": 101,
      "aya_no": 10,
      "aya_text": "نَارٌ حَامِيَةُۢۖ ١٠"
    },
    {
      "sura_no": 102,
      "aya_no": 1,
      "aya_text": "أَلْهَيٰكُمُ اُ۬لتَّكَاثُرُ ١"
    },
    {
      "sura_no": 102,
      "aya_no": 2,
      "aya_text": "حَتَّىٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ ٢"
    },
    {
      "sura_no": 102,
      "aya_no": 3,
      "aya_text": "كَلَّا سَوْفَ تَعْلَمُونَ ٣"
    },
    {
      "sura_no": 102,
      "aya_no": 4,
      "aya_text": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ ٤"
    },
    {
      "sura_no": 102,
      "aya_no": 5,
      "aya_text": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ ٥"
    },
    {
      "sura_no": 102,
      "aya_no": 6,
      "aya_text": "لَتَرَوُنَّ اَ۬لْجَحِيمَ ٦"
    },
    {
      "sura_no": 102,
      "aya_no": 7,
      "aya_text": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ ٧"
    },
    {
      "sura_no": 102,
      "aya_no": 8,
      "aya_text": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ ٨"
    }
  ],
  "page_text": "إِنَّ اَ۬لْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦ وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧ وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ ٨ ۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ ٩ وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ ١٠ إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٖ لَّخَبِيرُۢۖ ١١ اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ ١ وَمَا أَدْرَيٰكَ مَا اَ۬لْقَارِعَةُۖ ٢ يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ ٣ وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ ٤ فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ ٥ فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖۖ ٦ وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ ٧ فَأُمُّهُۥ هَاوِيَةٞۖ ٨ وَمَا أَدْرَيٰكَ مَا هِيَهْۖ ٩ نَارٌ حَامِيَةُۢۖ ١٠ أَلْهَيٰكُمُ اُ۬لتَّكَاثُرُ ١ حَتَّىٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ ٢ كَلَّا سَوْفَ تَعْلَمُونَ ٣ ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ ٤ كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ ٥ لَتَرَوُنَّ اَ۬لْجَحِيمَ ٦ ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ ٧ ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ ٨"
}