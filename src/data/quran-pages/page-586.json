    }
  ],
  "ayahs": [
    {
      "sura_no": 80,
      "aya_no": 41,
      "aya_text": "تَرْهَقُهَا قَتَرَةٌۖ ٤١"
    },
    {
      "sura_no": 80,
      "aya_no": 42,
      "aya_text": "أُوْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ ٤٢"
    },
    {
      "sura_no": 81,
      "aya_no": 1,
      "aya_text": "إِذَا اَ۬لشَّمْسُ كُوِّرَتْ ١"
    },
    {
      "sura_no": 81,
      "aya_no": 2,
      "aya_text": "وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ ٢"
    },
    {
      "sura_no": 81,
      "aya_no": 3,
      "aya_text": "وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ ٣"
    },
    {
      "sura_no": 81,
      "aya_no": 4,
      "aya_text": "وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ ٤"
    },
    {
      "sura_no": 81,
      "aya_no": 5,
      "aya_text": "وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ ٥"
    },
    {
      "sura_no": 81,
      "aya_no": 6,
      "aya_text": "وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ ٦"
    },
    {
      "sura_no": 81,
      "aya_no": 7,
      "aya_text": "وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ ٧"
    },
    {
      "sura_no": 81,
      "aya_no": 8,
      "aya_text": "وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ ٨"
    },
    {
      "sura_no": 81,
      "aya_no": 9,
      "aya_text": "بِأَيِّ ذَنۢبٖ قُتِلَتْ ٩"
    },
    {
      "sura_no": 81,
      "aya_no": 10,
      "aya_text": "وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ ١٠"
    },
    {
      "sura_no": 81,
      "aya_no": 11,
      "aya_text": "وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ ١١"
    },
    {
      "sura_no": 81,
      "aya_no": 12,
      "aya_text": "وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ ١٢"
    },
    {
      "sura_no": 81,
      "aya_no": 13,
      "aya_text": "وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ ١٣"
    },
    {
      "sura_no": 81,
      "aya_no": 14,
      "aya_text": "عَلِمَتْ نَفْسٞ مَّا أَحْضَرَتْۖ ١٤"
    },
    {
      "sura_no": 81,
      "aya_no": 15,
      "aya_text": "فَلَا أُقْسِمُ بِالْخُنَّسِ ١٥"
    },
    {
      "sura_no": 81,
      "aya_no": 16,
      "aya_text": "اِ۬لْجَوَارِ اِ۬لْكُنَّسِ ١٦"
    },
    {
      "sura_no": 81,
      "aya_no": 17,
      "aya_text": "وَاليْلِ إِذَا عَسْعَسَ ١٧"
    },
    {
      "sura_no": 81,
      "aya_no": 18,
      "aya_text": "وَالصُّبْحِ إِذَا تَنَفَّسَ ١٨"
    },
    {
      "sura_no": 81,
      "aya_no": 19,
      "aya_text": "إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ ١٩"
    },
    {
      "sura_no": 81,
      "aya_no": 20,
      "aya_text": "ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ ٢٠"
    },
    {
      "sura_no": 81,
      "aya_no": 21,
      "aya_text": "مُّطَاعٖ ثَمَّ أَمِينٖۖ ٢١"
    },
    {
      "sura_no": 81,
      "aya_no": 22,
      "aya_text": "وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ ٢٢"
    },
    {
      "sura_no": 81,
      "aya_no": 23,
      "aya_text": "وَلَقَدْ رَءَاهُ بِالْأُفُقِ اِ۬لْمُبِينِۖ ٢٣"
    },
    {
      "sura_no": 81,
      "aya_no": 24,
      "aya_text": "وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ ٢٤"
    },
    {
      "sura_no": 81,
      "aya_no": 25,
      "aya_text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ ٢٥"
    },
    {
      "sura_no": 81,
      "aya_no": 26,
      "aya_text": "فَأَيْنَ تَذْهَبُونَۖ ٢٦"
    },
    {
      "sura_no": 81,
      "aya_no": 27,
      "aya_text": "إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ ٢٧"
    },
    {
      "sura_no": 81,
      "aya_no": 28,
      "aya_text": "لِمَن شَآءَ مِنكُمْ أَنْ يَّسْتَقِيمَۖ ٢٨"
    },
    {
      "sura_no": 81,
      "aya_no": 29,
      "aya_text": "وَمَا تَشَآءُونَ إِلَّا أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ ٢٩"
    }
  ],
  "page_text": "تَرْهَقُهَا قَتَرَةٌۖ ٤١ أُوْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ ٤٢ إِذَا اَ۬لشَّمْسُ كُوِّرَتْ ١ وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ ٢ وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ ٣ وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ ٤ وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ ٥ وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ ٦ وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ ٧ وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ ٨ بِأَيِّ ذَنۢبٖ قُتِلَتْ ٩ وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ ١٠ وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ ١١ وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ ١٢ وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ ١٣ عَلِمَتْ نَفْسٞ مَّا أَحْضَرَتْۖ ١٤ فَلَا أُقْسِمُ بِالْخُنَّسِ ١٥ اِ۬لْجَوَارِ اِ۬لْكُنَّسِ ١٦ وَاليْلِ إِذَا عَسْعَسَ ١٧ وَالصُّبْحِ إِذَا تَنَفَّسَ ١٨ إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ ١٩ ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ ٢٠ مُّطَاعٖ ثَمَّ أَمِينٖۖ ٢١ وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ ٢٢ وَلَقَدْ رَءَاهُ بِالْأُفُقِ اِ۬لْمُبِينِۖ ٢٣ وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ ٢٤ وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ ٢٥ فَأَيْنَ تَذْهَبُونَۖ ٢٦ إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ ٢٧ لِمَن شَآءَ مِنكُمْ أَنْ يَّسْتَقِيمَۖ ٢٨ وَمَا تَشَآءُونَ إِلَّا أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ ٢٩"
}