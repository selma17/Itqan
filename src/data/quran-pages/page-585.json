  "surahs": [
    {
      "sura_no": 80,
      "sura_name_ar": "عَبَسَ",
      "sura_name_en": "‘Abasa",
      "type": "meccan",
      "starts_here": true
    }
  ],
  "ayahs": [
    {
      "sura_no": 80,
      "aya_no": 1,
      "aya_text": "عَبَسَ وَتَوَلَّىٰ ١"
    },
    {
      "sura_no": 80,
      "aya_no": 2,
      "aya_text": "أَن جَآءَهُ اُ۬لْأَعْمَىٰۖ ٢"
    },
    {
      "sura_no": 80,
      "aya_no": 3,
      "aya_text": "وَمَا يُدْرِيكَۖ لَعَلَّهُۥ يَزَّكَّىٰ ٣"
    },
    {
      "sura_no": 80,
      "aya_no": 4,
      "aya_text": "أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْرَىٰۖ ٤"
    },
    {
      "sura_no": 80,
      "aya_no": 5,
      "aya_text": "أَمَّا مَنِ اِ۪سْتَغْنَىٰ ٥"
    },
    {
      "sura_no": 80,
      "aya_no": 6,
      "aya_text": "فَأَنتَ لَهُۥ تَصَّدَّىٰ ٦"
    },
    {
      "sura_no": 80,
      "aya_no": 7,
      "aya_text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰۖ ٧"
    },
    {
      "sura_no": 80,
      "aya_no": 8,
      "aya_text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ ٨"
    },
    {
      "sura_no": 80,
      "aya_no": 9,
      "aya_text": "وَهْوَ يَخْشَىٰ ٩"
    },
    {
      "sura_no": 80,
      "aya_no": 10,
      "aya_text": "فَأَنتَ عَنْهُ تَلَهَّىٰ ١٠"
    },
    {
      "sura_no": 80,
      "aya_no": 11,
      "aya_text": "كَلَّاۖ إِنَّهَا تَذْكِرَةٞۖ ١١"
    },
    {
      "sura_no": 80,
      "aya_no": 12,
      "aya_text": "فَمَن شَآءَ ذَكَرَهُۥ ١٢"
    },
    {
      "sura_no": 80,
      "aya_no": 13,
      "aya_text": "فِے صُحُفٖ مُّكَرَّمَةٖ ١٣"
    },
    {
      "sura_no": 80,
      "aya_no": 14,
      "aya_text": "مَّرْفُوعَةٖ مُّطَهَّرَةِۢ ١٤"
    },
    {
      "sura_no": 80,
      "aya_no": 15,
      "aya_text": "بِأَيْدِے سَفَرَةٖ ١٥"
    },
    {
      "sura_no": 80,
      "aya_no": 16,
      "aya_text": "كِرَامِۢ بَرَرَةٖۖ ١٦"
    },
    {
      "sura_no": 80,
      "aya_no": 17,
      "aya_text": "قُتِلَ اَ۬لْإِنسَٰنُ مَا أَكْفَرَهُۥۖ ١٧"
    },
    {
      "sura_no": 80,
      "aya_no": 18,
      "aya_text": "مِنْ أَيِّ شَےْءٍ خَلَقَهُۥۖ ١٨"
    },
    {
      "sura_no": 80,
      "aya_no": 19,
      "aya_text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩"
    },
    {
      "sura_no": 80,
      "aya_no": 20,
      "aya_text": "ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ ٢٠"
    },
    {
      "sura_no": 80,
      "aya_no": 21,
      "aya_text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ ٢١"
    },
    {
      "sura_no": 80,
      "aya_no": 22,
      "aya_text": "ثُمَّ إِذَا شَا أَنشَرَهُۥۖ ٢٢"
    },
    {
      "sura_no": 80,
      "aya_no": 23,
      "aya_text": "كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُۥۖ ٢٣"
    },
    {
      "sura_no": 80,
      "aya_no": 24,
      "aya_text": "فَلْيَنظُرِ اِ۬لْإِنسَٰنُ إِلَىٰ طَعَامِهِۦۖ ٢٤"
    },
    {
      "sura_no": 80,
      "aya_no": 25,
      "aya_text": "إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ ٢٥"
    },
    {
      "sura_no": 80,
      "aya_no": 26,
      "aya_text": "ثُمَّ شَقَقْنَا اَ۬لْأَرْضَ شَقّاٗ ٢٦"
    },
    {
      "sura_no": 80,
      "aya_no": 27,
      "aya_text": "فَأَنۢبَتْنَا فِيهَا حَبّاٗ ٢٧"
    },
    {
      "sura_no": 80,
      "aya_no": 28,
      "aya_text": "وَعِنَباٗ وَقَضْباٗ ٢٨"
    },
    {
      "sura_no": 80,
      "aya_no": 29,
      "aya_text": "وَزَيْتُوناٗ وَنَخْلاٗ ٢٩"
    },
    {
      "sura_no": 80,
      "aya_no": 30,
      "aya_text": "وَحَدَآئِقَ غُلْباٗ ٣٠"
    },
    {
      "sura_no": 80,
      "aya_no": 31,
      "aya_text": "وَفَٰكِهَةٗ وَأَبّاٗ ٣١"
    },
    {
      "sura_no": 80,
      "aya_no": 32,
      "aya_text": "مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ٣٢"
    },
    {
      "sura_no": 80,
      "aya_no": 33,
      "aya_text": "فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ ٣٣"
    },
    {
      "sura_no": 80,
      "aya_no": 34,
      "aya_text": "يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنْ أَخِيهِ ٣٤"
    },
    {
      "sura_no": 80,
      "aya_no": 35,
      "aya_text": "وَأُمِّهِۦ وَأَبِيهِ ٣٥"
    },
    {
      "sura_no": 80,
      "aya_no": 36,
      "aya_text": "وَصَٰحِبَتِهِۦ وَبَنِيهِۖ ٣٦"
    },
    {
      "sura_no": 80,
      "aya_no": 37,
      "aya_text": "لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ ٣٧"
    },
    {
      "sura_no": 80,
      "aya_no": 38,
      "aya_text": "وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ ٣٨"
    },
    {
      "sura_no": 80,
      "aya_no": 39,
      "aya_text": "ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ ٣٩"
    },
    {
      "sura_no": 80,
      "aya_no": 40,
      "aya_text": "وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ ٤٠"
    }
  ],
  "page_text": "عَبَسَ وَتَوَلَّىٰ ١ أَن جَآءَهُ اُ۬لْأَعْمَىٰۖ ٢ وَمَا يُدْرِيكَۖ لَعَلَّهُۥ يَزَّكَّىٰ ٣ أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْرَىٰۖ ٤ أَمَّا مَنِ اِ۪سْتَغْنَىٰ ٥ فَأَنتَ لَهُۥ تَصَّدَّىٰ ٦ وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰۖ ٧ وَأَمَّا مَن جَآءَكَ يَسْعَىٰ ٨ وَهْوَ يَخْشَىٰ ٩ فَأَنتَ عَنْهُ تَلَهَّىٰ ١٠ كَلَّاۖ إِنَّهَا تَذْكِرَةٞۖ ١١ فَمَن شَآءَ ذَكَرَهُۥ ١٢ فِے صُحُفٖ مُّكَرَّمَةٖ ١٣ مَّرْفُوعَةٖ مُّطَهَّرَةِۢ ١٤ بِأَيْدِے سَفَرَةٖ ١٥ كِرَامِۢ بَرَرَةٖۖ ١٦ قُتِلَ اَ۬لْإِنسَٰنُ مَا أَكْفَرَهُۥۖ ١٧ مِنْ أَيِّ شَےْءٍ خَلَقَهُۥۖ ١٨ مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩ ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ ٢٠ ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ ٢١ ثُمَّ إِذَا شَا أَنشَرَهُۥۖ ٢٢ كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُۥۖ ٢٣ فَلْيَنظُرِ اِ۬لْإِنسَٰنُ إِلَىٰ طَعَامِهِۦۖ ٢٤ إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ ٢٥ ثُمَّ شَقَقْنَا اَ۬لْأَرْضَ شَقّاٗ ٢٦ فَأَنۢبَتْنَا فِيهَا حَبّاٗ ٢٧ وَعِنَباٗ وَقَضْباٗ ٢٨ وَزَيْتُوناٗ وَنَخْلاٗ ٢٩ وَحَدَآئِقَ غُلْباٗ ٣٠ وَفَٰكِهَةٗ وَأَبّاٗ ٣١ مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ٣٢ فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ ٣٣ يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنْ أَخِيهِ ٣٤ وَأُمِّهِۦ وَأَبِيهِ ٣٥ وَصَٰحِبَتِهِۦ وَبَنِيهِۖ ٣٦ لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ ٣٧ وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ ٣٨ ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ ٣٩ وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ ٤٠"
}