  "ayahs": [
    {
      "sura_no": 106,
      "aya_no": 1,
      "aya_text": "لِإِيلَٰفِ قُرَيْشٍ ١"
    },
    {
      "sura_no": 106,
      "aya_no": 2,
      "aya_text": "إِيلَٰفِهِمْ رِحْلَةَ اَ۬لشِّتَآءِ وَالصَّيْفِۖ ٢"
    },
    {
      "sura_no": 106,
      "aya_no": 3,
      "aya_text": "فَلْيَعْبُدُواْ رَبَّ هَٰذَا اَ۬لْبَيْتِ ٣"
    },
    {
      "sura_no": 106,
      "aya_no": 4,
      "aya_text": "اِ۬لذِے أَطْعَمَهُم مِّن جُوعٖ ٤"
    },
    {
      "sura_no": 106,
      "aya_no": 5,
      "aya_text": "وَءَامَنَهُم مِّنْ خَوْفِۢۖ ٥"
    },
    {
      "sura_no": 107,
      "aya_no": 1,
      "aya_text": "أَرَٰ۬يْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ ١"
    },
    {
      "sura_no": 107,
      "aya_no": 2,
      "aya_text": "فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ ٢"
    },
    {
      "sura_no": 107,
      "aya_no": 3,
      "aya_text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ ٣"
    },
    {
      "sura_no": 107,
      "aya_no": 4,
      "aya_text": "فَوَيْلٞ لِّلْمُصَلِّينَ ٤"
    },
    {
      "sura_no": 107,
      "aya_no": 5,
      "aya_text": "اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ ٥"
    },
    {
      "sura_no": 107,
      "aya_no": 6,
      "aya_text": "اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ ٦"
    },
    {
      "sura_no": 108,
      "aya_no": 1,
      "aya_text": "إِنَّا أَعْطَيْنَٰكَ اَ۬لْكَوْثَرَ ١"
    },
    {
      "sura_no": 108,
      "aya_no": 2,
      "aya_text": "فَصَلِّ لِرَبِّكَ وَانْحَرْۖ ٢"
    },
    {
      "sura_no": 108,
      "aya_no": 3,
      "aya_text": "إِنَّ شَانِئَكَ هُوَ اَ۬لْأَبْتَرُۖ ٣"
    }
  ],
  "page_text": "لِإِيلَٰفِ قُرَيْشٍ ١ إِيلَٰفِهِمْ رِحْلَةَ اَ۬لشِّتَآءِ وَالصَّيْفِۖ ٢ فَلْيَعْبُدُواْ رَبَّ هَٰذَا اَ۬لْبَيْتِ ٣ اِ۬لذِے أَطْعَمَهُم مِّن جُوعٖ ٤ وَءَامَنَهُم مِّنْ خَوْفِۢۖ ٥ أَرَٰ۬يْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ ١ فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ ٢ وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ ٣ فَوَيْلٞ لِّلْمُصَلِّينَ ٤ اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ ٥ اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ ٦ إِنَّا أَعْطَيْنَٰكَ اَ۬لْكَوْثَرَ ١ فَصَلِّ لِرَبِّكَ وَانْحَرْۖ ٢ إِنَّ شَانِئَكَ هُوَ اَ۬لْأَبْتَرُۖ ٣"
}