  "ayahs": [
    {
      "sura_no": 90,
      "aya_no": 19,
      "aya_text": "وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ ١٩"
    },
    {
      "sura_no": 90,
      "aya_no": 20,
      "aya_text": "عَلَيْهِمْ نَارٞ مُّوصَدَةُۢۖ ٢٠"
    },
    {
      "sura_no": 91,
      "aya_no": 1,
      "aya_text": "وَالشَّمْسِ وَضُحَيٰهَا ١"
    },
    {
      "sura_no": 91,
      "aya_no": 2,
      "aya_text": "وَالْقَمَرِ إِذَا تَلَيٰهَا ٢"
    },
    {
      "sura_no": 91,
      "aya_no": 3,
      "aya_text": "وَالنَّهَارِ إِذَا جَلَّيٰهَا ٣"
    },
    {
      "sura_no": 91,
      "aya_no": 4,
      "aya_text": "وَاليْلِ إِذَا يَغْشَيٰهَا ٤"
    },
    {
      "sura_no": 91,
      "aya_no": 5,
      "aya_text": "وَالسَّمَآءِ وَمَا بَنَيٰهَا ٥"
    },
    {
      "sura_no": 91,
      "aya_no": 6,
      "aya_text": "وَالْأَرْضِ وَمَا طَحَيٰهَا ٦"
    },
    {
      "sura_no": 91,
      "aya_no": 7,
      "aya_text": "وَنَفْسٖ وَمَا سَوَّيٰهَا ٧"
    },
    {
      "sura_no": 91,
      "aya_no": 8,
      "aya_text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا ٨"
    },
    {
      "sura_no": 91,
      "aya_no": 9,
      "aya_text": "قَدْ أَفْلَحَ مَن زَكَّيٰهَا ٩"
    },
    {
      "sura_no": 91,
      "aya_no": 10,
      "aya_text": "وَقَدْ خَابَ مَن دَسَّيٰهَاۖ ١٠"
    },
    {
      "sura_no": 91,
      "aya_no": 11,
      "aya_text": "كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَا ١١"
    },
    {
      "sura_no": 91,
      "aya_no": 12,
      "aya_text": "إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا ١٢"
    },
    {
      "sura_no": 91,
      "aya_no": 13,
      "aya_text": "فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا ١٣"
    },
    {
      "sura_no": 91,
      "aya_no": 14,
      "aya_text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ ١٤"
    },
    {
      "sura_no": 91,
      "aya_no": 15,
      "aya_text": "فَلَا يَخَافُ عُقْبَٰهَاۖ ١٥"
    },
    {
      "sura_no": 92,
      "aya_no": 1,
      "aya_text": "وَاليْلِ إِذَا يَغْشَىٰ ١"
    },
    {
      "sura_no": 92,
      "aya_no": 2,
      "aya_text": "وَالنَّهَارِ إِذَا تَجَلَّىٰ ٢"
    },
    {
      "sura_no": 92,
      "aya_no": 3,
      "aya_text": "وَمَا خَلَقَ اَ۬لذَّكَرَ وَالْأُنثَىٰ ٣"
    },
    {
      "sura_no": 92,
      "aya_no": 4,
      "aya_text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰۖ ٤"
    },
    {
      "sura_no": 92,
      "aya_no": 5,
      "aya_text": "فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ ٥"
    },
    {
      "sura_no": 92,
      "aya_no": 6,
      "aya_text": "وَصَدَّقَ بِالْحُسْنَىٰ ٦"
    },
    {
      "sura_no": 92,
      "aya_no": 7,
      "aya_text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰۖ ٧"
    },
    {
      "sura_no": 92,
      "aya_no": 8,
      "aya_text": "وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْنَىٰ ٨"
    },
    {
      "sura_no": 92,
      "aya_no": 9,
      "aya_text": "وَكَذَّبَ بِالْحُسْنَىٰ ٩"
    }
  ],
  "page_text": "وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ ١٩ عَلَيْهِمْ نَارٞ مُّوصَدَةُۢۖ ٢٠ وَالشَّمْسِ وَضُحَيٰهَا ١ وَالْقَمَرِ إِذَا تَلَيٰهَا ٢ وَالنَّهَارِ إِذَا جَلَّيٰهَا ٣ وَاليْلِ إِذَا يَغْشَيٰهَا ٤ وَالسَّمَآءِ وَمَا بَنَيٰهَا ٥ وَالْأَرْضِ وَمَا طَحَيٰهَا ٦ وَنَفْسٖ وَمَا سَوَّيٰهَا ٧ فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَيٰهَا ٨ قَدْ أَفْلَحَ مَن زَكَّيٰهَا ٩ وَقَدْ خَابَ مَن دَسَّيٰهَاۖ ١٠ كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَا ١١ إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا ١٢ فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا ١٣ فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ ١٤ فَلَا يَخَافُ عُقْبَٰهَاۖ ١٥ وَاليْلِ إِذَا يَغْشَىٰ ١ وَالنَّهَارِ إِذَا تَجَلَّىٰ ٢ وَمَا خَلَقَ اَ۬لذَّكَرَ وَالْأُنثَىٰ ٣ إِنَّ سَعْيَكُمْ لَشَتَّىٰۖ ٤ فَأَمَّا مَنْ أَعْطَىٰ وَاتَّقَىٰ ٥ وَصَدَّقَ بِالْحُسْنَىٰ ٦ فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰۖ ٧ وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْنَىٰ ٨ وَكَذَّبَ بِالْحُسْنَىٰ ٩"
}