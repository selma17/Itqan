  "surahs": [
    {
      "sura_no": 78,
      "sura_name_ar": "النَّبَإ",
      "sura_name_en": "An-Naba’",
      "type": "meccan",
      "starts_here": true
    }
  ],
  "ayahs": [
    {
      "sura_no": 78,
      "aya_no": 1,
      "aya_text": "عَمَّ يَتَسَآءَلُونَ ١"
    },
    {
      "sura_no": 78,
      "aya_no": 2,
      "aya_text": "عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ ٢"
    },
    {
      "sura_no": 78,
      "aya_no": 3,
      "aya_text": "اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ ٣"
    },
    {
      "sura_no": 78,
      "aya_no": 4,
      "aya_text": "كَلَّا سَيَعْلَمُونَ ٤"
    },
    {
      "sura_no": 78,
      "aya_no": 5,
      "aya_text": "ثُمَّ كَلَّا سَيَعْلَمُونَۖ ٥"
    },
    {
      "sura_no": 78,
      "aya_no": 6,
      "aya_text": "أَلَمْ نَجْعَلِ اِ۬لْأَرْضَ مِهَٰداٗ ٦"
    },
    {
      "sura_no": 78,
      "aya_no": 7,
      "aya_text": "وَالْجِبَالَ أَوْتَاداٗ ٧"
    },
    {
      "sura_no": 78,
      "aya_no": 8,
      "aya_text": "وَخَلَقْنَٰكُمْ أَزْوَٰجاٗ ٨"
    },
    {
      "sura_no": 78,
      "aya_no": 9,
      "aya_text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ ٩"
    },
    {
      "sura_no": 78,
      "aya_no": 10,
      "aya_text": "وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ ١٠"
    },
    {
      "sura_no": 78,
      "aya_no": 11,
      "aya_text": "وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ ١١"
    },
    {
      "sura_no": 78,
      "aya_no": 12,
      "aya_text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ ١٢"
    },
    {
      "sura_no": 78,
      "aya_no": 13,
      "aya_text": "وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ ١٣"
    },
    {
      "sura_no": 78,
      "aya_no": 14,
      "aya_text": "وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ ١٤"
    },
    {
      "sura_no": 78,
      "aya_no": 15,
      "aya_text": "لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ ١٥"
    },
    {
      "sura_no": 78,
      "aya_no": 16,
      "aya_text": "وَجَنَّٰتٍ أَلْفَافاًۖ ١٦"
    },
    {
      "sura_no": 78,
      "aya_no": 17,
      "aya_text": "إِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ ١٧"
    },
    {
      "sura_no": 78,
      "aya_no": 18,
      "aya_text": "يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَأْتُونَ أَفْوَاجاٗ ١٨"
    },
    {
      "sura_no": 78,
      "aya_no": 19,
      "aya_text": "وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتْ أَبْوَاباٗ ١٩"
    },
    {
      "sura_no": 78,
      "aya_no": 20,
      "aya_text": "وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ ٢٠"
    },
    {
      "sura_no": 78,
      "aya_no": 21,
      "aya_text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ ٢١"
    },
    {
      "sura_no": 78,
      "aya_no": 22,
      "aya_text": "لِّلطَّٰغِينَ مَـَٔاباٗ ٢٢"
    },
    {
      "sura_no": 78,
      "aya_no": 23,
      "aya_text": "لَّٰبِثِينَ فِيهَا أَحْقَاباٗۖ ٢٣"
    },
    {
      "sura_no": 78,
      "aya_no": 24,
      "aya_text": "لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً ٢٤"
    },
    {
      "sura_no": 78,
      "aya_no": 25,
      "aya_text": "إِلَّا حَمِيماٗ وَغَسَاقاٗ ٢٥"
    },
    {
      "sura_no": 78,
      "aya_no": 26,
      "aya_text": "جَزَآءٗ وِفَاقاًۖ ٢٦"
    },
    {
      "sura_no": 78,
      "aya_no": 27,
      "aya_text": "إِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ ٢٧"
    },
    {
      "sura_no": 78,
      "aya_no": 28,
      "aya_text": "وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباٗۖ ٢٨"
    },
    {
      "sura_no": 78,
      "aya_no": 29,
      "aya_text": "وَكُلَّ شَےْءٍ أَحْصَيْنَٰهُ كِتَٰباٗۖ ٢٩"
    },
    {
      "sura_no": 78,
      "aya_no": 30,
      "aya_text": "فَذُوقُواْ فَلَن نَّزِيدَكُمْ إِلَّا عَذَاباًۖ ٣٠"
    }
  ],
  "page_text": "عَمَّ يَتَسَآءَلُونَ ١ عَنِ اِ۬لنَّبَإِ اِ۬لْعَظِيمِ ٢ اِ۬لذِے هُمْ فِيهِ مُخْتَلِفُونَۖ ٣ كَلَّا سَيَعْلَمُونَ ٤ ثُمَّ كَلَّا سَيَعْلَمُونَۖ ٥ أَلَمْ نَجْعَلِ اِ۬لْأَرْضَ مِهَٰداٗ ٦ وَالْجِبَالَ أَوْتَاداٗ ٧ وَخَلَقْنَٰكُمْ أَزْوَٰجاٗ ٨ وَجَعَلْنَا نَوْمَكُمْ سُبَاتاٗ ٩ وَجَعَلْنَا اَ۬ليْلَ لِبَاساٗ ١٠ وَجَعَلْنَا اَ۬لنَّهَارَ مَعَاشاٗ ١١ وَبَنَيْنَا فَوْقَكُمْ سَبْعاٗ شِدَاداٗ ١٢ وَجَعَلْنَا سِرَاجاٗ وَهَّاجاٗ ١٣ وَأَنزَلْنَا مِنَ اَ۬لْمُعْصِرَٰتِ مَآءٗ ثَجَّاجاٗ ١٤ لِّنُخْرِجَ بِهِۦ حَبّاٗ وَنَبَاتاٗ ١٥ وَجَنَّٰتٍ أَلْفَافاًۖ ١٦ إِنَّ يَوْمَ اَ۬لْفَصْلِ كَانَ مِيقَٰتاٗ ١٧ يَوْمَ يُنفَخُ فِے اِ۬لصُّورِ فَتَأْتُونَ أَفْوَاجاٗ ١٨ وَفُتِّحَتِ اِ۬لسَّمَآءُ فَكَانَتْ أَبْوَاباٗ ١٩ وَسُيِّرَتِ اِ۬لْجِبَالُ فَكَانَتْ سَرَاباًۖ ٢٠ إِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداٗ ٢١ لِّلطَّٰغِينَ مَـَٔاباٗ ٢٢ لَّٰبِثِينَ فِيهَا أَحْقَاباٗۖ ٢٣ لَّا يَذُوقُونَ فِيهَا بَرْداٗ وَلَا شَرَاباً ٢٤ إِلَّا حَمِيماٗ وَغَسَاقاٗ ٢٥ جَزَآءٗ وِفَاقاًۖ ٢٦ إِنَّهُمْ كَانُواْ لَا يَرْجُونَ حِسَاباٗ ٢٧ وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّاباٗۖ ٢٨ وَكُلَّ شَےْءٍ أَحْصَيْنَٰهُ كِتَٰباٗۖ ٢٩ فَذُوقُواْ فَلَن نَّزِيدَكُمْ إِلَّا عَذَاباًۖ ٣٠"
}