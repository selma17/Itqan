      "sura_name_ar": "النَّاس",
      "sura_name_en": "An-Nās",
      "type": "meccan",
      "starts_here": true
    }
  ],
  "ayahs": [
    {
      "sura_no": 112,
      "aya_no": 1,
      "aya_text": "قُلْ هُوَ اَ۬للَّهُ أَحَدٌۖ ١"
    },
    {
      "sura_no": 112,
      "aya_no": 2,
      "aya_text": "اِ۬للَّهُ اُ۬لصَّمَدُۖ ٢"
    },
    {
      "sura_no": 112,
      "aya_no": 3,
      "aya_text": "لَمْ يَلِدْ وَلَمْ يُولَدْۖ ٣"
    },
    {
      "sura_no": 112,
      "aya_no": 4,
      "aya_text": "وَلَمْ يَكُن لَّهُۥ كُفُؤاً أَحَدُۢۖ ٤"
    },
    {
      "sura_no": 113,
      "aya_no": 1,
      "aya_text": "قُلْ أَعُوذُ بِرَبِّ اِ۬لْفَلَقِ ١"
    },
    {
      "sura_no": 113,
      "aya_no": 2,
      "aya_text": "مِن شَرِّ مَا خَلَقَ ٢"
    },
    {
      "sura_no": 113,
      "aya_no": 3,
      "aya_text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ٣"
    },
    {
      "sura_no": 113,
      "aya_no": 4,
      "aya_text": "وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِے اِ۬لْعُقَدِ ٤"
    },
    {
      "sura_no": 113,
      "aya_no": 5,
      "aya_text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَۖ ٥"
    },
    {
      "sura_no": 114,
      "aya_no": 1,
      "aya_text": "قُلْ أَعُوذُ بِرَبِّ اِ۬لنَّاسِ ١"
    },
    {
      "sura_no": 114,
      "aya_no": 2,
      "aya_text": "مَلِكِ اِ۬لنَّاسِ ٢"
    },
    {
      "sura_no": 114,
      "aya_no": 3,
      "aya_text": "إِلَٰهِ اِ۬لنَّاسِ ٣"
    },
    {
      "sura_no": 114,
      "aya_no": 4,
      "aya_text": "مِن شَرِّ اِ۬لْوَسْوَاسِ اِ۬لْخَنَّاسِ ٤"
    },
    {
      "sura_no": 114,
      "aya_no": 5,
      "aya_text": "اِ۬لذِے يُوَسْوِسُ فِے صُدُورِ اِ۬لنَّاسِ ٥"
    },
    {
      "sura_no": 114,
      "aya_no": 6,
      "aya_text": "مِنَ اَ۬لْجِنَّةِ وَالنَّاسِۖ ٦"
    }
  ],
  "page_text": "قُلْ هُوَ اَ۬للَّهُ أَحَدٌۖ ١ اِ۬للَّهُ اُ۬لصَّمَدُۖ ٢ لَمْ يَلِدْ وَلَمْ يُولَدْۖ ٣ وَلَمْ يَكُن لَّهُۥ كُفُؤاً أَحَدُۢۖ ٤ قُلْ أَعُوذُ بِرَبِّ اِ۬لْفَلَقِ ١ مِن شَرِّ مَا خَلَقَ ٢ وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ٣ وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِے اِ۬لْعُقَدِ ٤ وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَۖ ٥ قُلْ أَعُوذُ بِرَبِّ اِ۬لنَّاسِ ١ مَلِكِ اِ۬لنَّاسِ ٢ إِلَٰهِ اِ۬لنَّاسِ ٣ مِن شَرِّ اِ۬لْوَسْوَاسِ اِ۬لْخَنَّاسِ ٤ اِ۬لذِے يُوَسْوِسُ فِے صُدُورِ اِ۬لنَّاسِ ٥ مِنَ اَ۬لْجِنَّةِ وَالنَّاسِۖ ٦"
}