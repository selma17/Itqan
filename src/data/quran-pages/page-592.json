    {
      "sura_no": 88,
      "sura_name_ar": "الغَاشِية",
      "sura_name_en": "Al-Ghāshiyah",
      "type": "meccan",
      "starts_here": true
    }
  ],
  "ayahs": [
    {
      "sura_no": 87,
      "aya_no": 11,
      "aya_text": "وَيَتَجَنَّبُهَا اَ۬لْأَشْقَى ١١"
    },
    {
      "sura_no": 87,
      "aya_no": 12,
      "aya_text": "اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْرَىٰ ١٢"
    },
    {
      "sura_no": 87,
      "aya_no": 13,
      "aya_text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ ١٣"
    },
    {
      "sura_no": 87,
      "aya_no": 14,
      "aya_text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ ١٤"
    },
    {
      "sura_no": 87,
      "aya_no": 15,
      "aya_text": "وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلَّىٰۖ ١٥"
    },
    {
      "sura_no": 87,
      "aya_no": 16,
      "aya_text": "بَلْ تُؤْثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا ١٦"
    },
    {
      "sura_no": 87,
      "aya_no": 17,
      "aya_text": "وَالْأٓخِرَةُ خَيْرٞ وَأَبْقَىٰۖ ١٧"
    },
    {
      "sura_no": 87,
      "aya_no": 18,
      "aya_text": "إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لْأُولَىٰ ١٨"
    },
    {
      "sura_no": 87,
      "aya_no": 19,
      "aya_text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ ١٩"
    },
    {
      "sura_no": 88,
      "aya_no": 1,
      "aya_text": "هَلْ أَتَيٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ ١"
    },
    {
      "sura_no": 88,
      "aya_no": 2,
      "aya_text": "وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ ٢"
    },
    {
      "sura_no": 88,
      "aya_no": 3,
      "aya_text": "عَامِلَةٞ نَّاصِبَةٞ ٣"
    },
    {
      "sura_no": 88,
      "aya_no": 4,
      "aya_text": "تَصْلَىٰ نَاراً حَامِيَةٗ ٤"
    },
    {
      "sura_no": 88,
      "aya_no": 5,
      "aya_text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٖۖ ٥"
    },
    {
      "sura_no": 88,
      "aya_no": 6,
      "aya_text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦"
    },
    {
      "sura_no": 88,
      "aya_no": 7,
      "aya_text": "لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ ٧"
    },
    {
      "sura_no": 88,
      "aya_no": 8,
      "aya_text": "وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ ٨"
    },
    {
      "sura_no": 88,
      "aya_no": 9,
      "aya_text": "لِّسَعْيِهَا رَاضِيَةٞ ٩"
    },
    {
      "sura_no": 88,
      "aya_no": 10,
      "aya_text": "فِے جَنَّةٍ عَالِيَةٖ ١٠"
    },
    {
      "sura_no": 88,
      "aya_no": 11,
      "aya_text": "لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ ١١"
    },
    {
      "sura_no": 88,
      "aya_no": 12,
      "aya_text": "فِيهَا عَيْنٞ جَارِيَةٞۖ ١٢"
    },
    {
      "sura_no": 88,
      "aya_no": 13,
      "aya_text": "فِيهَا سُرُرٞ مَّرْفُوعَةٞ ١٣"
    },
    {
      "sura_no": 88,
      "aya_no": 14,
      "aya_text": "وَأَكْوَابٞ مَّوْضُوعَةٞ ١٤"
    },
    {
      "sura_no": 88,
      "aya_no": 15,
      "aya_text": "وَنَمَارِقُ مَصْفُوفَةٞ ١٥"
    },
    {
      "sura_no": 88,
      "aya_no": 16,
      "aya_text": "وَزَرَابِيُّ مَبْثُوثَةٌۖ ١٦"
    },
    {
      "sura_no": 88,
      "aya_no": 17,
      "aya_text": "۞ أَفَلَا يَنظُرُونَ إِلَى اَ۬لْإِبِلِ كَيْفَ خُلِقَتْ ١٧"
    },
    {
      "sura_no": 88,
      "aya_no": 18,
      "aya_text": "وَإِلَى اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ ١٨"
    },
    {
      "sura_no": 88,
      "aya_no": 19,
      "aya_text": "وَإِلَى اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ ١٩"
    },
    {
      "sura_no": 88,
      "aya_no": 20,
      "aya_text": "وَإِلَى اَ۬لْأَرْضِ كَيْفَ سُطِحَتْۖ ٢٠"
    },
    {
      "sura_no": 88,
      "aya_no": 21,
      "aya_text": "فَذَكِّرْ إِنَّمَا أَنتَ مُذَكِّرٞۖ ٢١"
    },
    {
      "sura_no": 88,
      "aya_no": 22,
      "aya_text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ ٢٢"
    }
  ],
  "page_text": "وَيَتَجَنَّبُهَا اَ۬لْأَشْقَى ١١ اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْرَىٰ ١٢ ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ ١٣ قَدْ أَفْلَحَ مَن تَزَكَّىٰ ١٤ وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلَّىٰۖ ١٥ بَلْ تُؤْثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا ١٦ وَالْأٓخِرَةُ خَيْرٞ وَأَبْقَىٰۖ ١٧ إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لْأُولَىٰ ١٨ صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ ١٩ هَلْ أَتَيٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ ١ وُجُوهٞ يَوْمَئِذٍ خَٰشِعَةٌ ٢ عَامِلَةٞ نَّاصِبَةٞ ٣ تَصْلَىٰ نَاراً حَامِيَةٗ ٤ تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٖۖ ٥ لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٖ ٦ لَّا يُسْمِنُ وَلَا يُغْنِے مِن جُوعٖۖ ٧ وُجُوهٞ يَوْمَئِذٖ نَّاعِمَةٞ ٨ لِّسَعْيِهَا رَاضِيَةٞ ٩ فِے جَنَّةٍ عَالِيَةٖ ١٠ لَّا تُسْمَعُ فِيهَا لَٰغِيَةٞۖ ١١ فِيهَا عَيْنٞ جَارِيَةٞۖ ١٢ فِيهَا سُرُرٞ مَّرْفُوعَةٞ ١٣ وَأَكْوَابٞ مَّوْضُوعَةٞ ١٤ وَنَمَارِقُ مَصْفُوفَةٞ ١٥ وَزَرَابِيُّ مَبْثُوثَةٌۖ ١٦ ۞ أَفَلَا يَنظُرُونَ إِلَى اَ۬لْإِبِلِ كَيْفَ خُلِقَتْ ١٧ وَإِلَى اَ۬لسَّمَآءِ كَيْفَ رُفِعَتْ ١٨ وَإِلَى اَ۬لْجِبَالِ كَيْفَ نُصِبَتْ ١٩ وَإِلَى اَ۬لْأَرْضِ كَيْفَ سُطِحَتْۖ ٢٠ فَذَكِّرْ إِنَّمَا أَنتَ مُذَكِّرٞۖ ٢١ لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍۖ ٢٢"
}