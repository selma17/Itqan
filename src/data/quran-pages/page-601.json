  ],
  "ayahs": [
    {
      "sura_no": 103,
      "aya_no": 1,
      "aya_text": "وَالْعَصْرِ إِنَّ اَ۬لْإِنسَٰنَ لَفِے خُسْرٍ ١"
    },
    {
      "sura_no": 103,
      "aya_no": 2,
      "aya_text": "إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ وَتَوَاصَوْاْ بِالْحَقِّ ٢"
    },
    {
      "sura_no": 103,
      "aya_no": 3,
      "aya_text": "وَتَوَاصَوْاْ بِالصَّبْرِۖ ٣"
    },
    {
      "sura_no": 104,
      "aya_no": 1,
      "aya_text": "وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١"
    },
    {
      "sura_no": 104,
      "aya_no": 2,
      "aya_text": "اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ ٢"
    },
    {
      "sura_no": 104,
      "aya_no": 3,
      "aya_text": "يَحْسِبُ أَنَّ مَالَهُۥ أَخْلَدَهُۥ ٣"
    },
    {
      "sura_no": 104,
      "aya_no": 4,
      "aya_text": "كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ ٤"
    },
    {
      "sura_no": 104,
      "aya_no": 5,
      "aya_text": "وَمَا أَدْرَيٰكَ مَا اَ۬لْحُطَمَةُۖ ٥"
    },
    {
      "sura_no": 104,
      "aya_no": 6,
      "aya_text": "نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ ٦"
    },
    {
      "sura_no": 104,
      "aya_no": 7,
      "aya_text": "اُ۬لتِے تَطَّلِعُ عَلَى اَ۬لْأَفْـِٕدَةِۖ ٧"
    },
    {
      "sura_no": 104,
      "aya_no": 8,
      "aya_text": "إِنَّهَا عَلَيْهِم مُّوصَدَةٞ ٨"
    },
    {
      "sura_no": 104,
      "aya_no": 9,
      "aya_text": "فِے عَمَدٖ مُّمَدَّدَةِۢۖ ٩"
    },
    {
      "sura_no": 105,
      "aya_no": 1,
      "aya_text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ ١"
    },
    {
      "sura_no": 105,
      "aya_no": 2,
      "aya_text": "أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ ٢"
    },
    {
      "sura_no": 105,
      "aya_no": 3,
      "aya_text": "وَأَرْسَلَ عَلَيْهِمْ طَيْراً أَبَابِيلَ ٣"
    },
    {
      "sura_no": 105,
      "aya_no": 4,
      "aya_text": "تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ ٤"
    },
    {
      "sura_no": 105,
      "aya_no": 5,
      "aya_text": "فَجَعَلَهُمْ كَعَصْفٖ مَّأْكُولِۢۖ ٥"
    }
  ],
  "page_text": "وَالْعَصْرِ إِنَّ اَ۬لْإِنسَٰنَ لَفِے خُسْرٍ ١ إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ وَتَوَاصَوْاْ بِالْحَقِّ ٢ وَتَوَاصَوْاْ بِالصَّبْرِۖ ٣ وَيْلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ ١ اِ۬لذِے جَمَعَ مَالاٗ وَعَدَّدَهُۥ ٢ يَحْسِبُ أَنَّ مَالَهُۥ أَخْلَدَهُۥ ٣ كَلَّاۖ لَيُنۢبَذَنَّ فِے اِ۬لْحُطَمَةِۖ ٤ وَمَا أَدْرَيٰكَ مَا اَ۬لْحُطَمَةُۖ ٥ نَارُ اُ۬للَّهِ اِ۬لْمُوقَدَةُ ٦ اُ۬لتِے تَطَّلِعُ عَلَى اَ۬لْأَفْـِٕدَةِۖ ٧ إِنَّهَا عَلَيْهِم مُّوصَدَةٞ ٨ فِے عَمَدٖ مُّمَدَّدَةِۢۖ ٩ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ ١ أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ ٢ وَأَرْسَلَ عَلَيْهِمْ طَيْراً أَبَابِيلَ ٣ تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ ٤ فَجَعَلَهُمْ كَعَصْفٖ مَّأْكُولِۢۖ ٥"
}