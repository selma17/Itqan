  "ayahs": [
    {
      "sura_no": 109,
      "aya_no": 1,
      "aya_text": "قُلْ يَٰأَيُّهَا اَ۬لْكَٰفِرُونَ ١"
    },
    {
      "sura_no": 109,
      "aya_no": 2,
      "aya_text": "لَا أَعْبُدُ مَا تَعْبُدُونَ ٢"
    },
    {
      "sura_no": 109,
      "aya_no": 3,
      "aya_text": "وَلَا أَنتُمْ عَٰبِدُونَ مَا أَعْبُدُۖ ٣"
    },
    {
      "sura_no": 109,
      "aya_no": 4,
      "aya_text": "وَلَا أَنَا عَابِدٞ مَّا عَبَدتُّمْ ٤"
    },
    {
      "sura_no": 109,
      "aya_no": 5,
      "aya_text": "وَلَا أَنتُمْ عَٰبِدُونَ مَا أَعْبُدُۖ ٥"
    },
    {
      "sura_no": 109,
      "aya_no": 6,
      "aya_text": "لَكُمْ دِينُكُمْ وَلِيَ دِينِۖ ٦"
    },
    {
      "sura_no": 110,
      "aya_no": 1,
      "aya_text": "إِذَا جَآءَ نَصْرُ اُ۬للَّهِ وَالْفَتْحُ ١"
    },
    {
      "sura_no": 110,
      "aya_no": 2,
      "aya_text": "وَرَأَيْتَ اَ۬لنَّاسَ يَدْخُلُونَ فِے دِينِ اِ۬للَّهِ أَفْوَاجاٗ ٢"
    },
    {
      "sura_no": 110,
      "aya_no": 3,
      "aya_text": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُۖ إِنَّهُۥ كَانَ تَوَّاباَۢۖ ٣"
    },
    {
      "sura_no": 111,
      "aya_no": 1,
      "aya_text": "تَبَّتْ يَدَا أَبِے لَهَبٖ وَتَبَّۖ ١"
    },
    {
      "sura_no": 111,
      "aya_no": 2,
      "aya_text": "مَا أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَۖ ٢"
    },
    {
      "sura_no": 111,
      "aya_no": 3,
      "aya_text": "سَيَصْلَىٰ نَاراٗ ذَاتَ لَهَبٖ ٣"
    },
    {
      "sura_no": 111,
      "aya_no": 4,
      "aya_text": "وَامْرَأَتُهُۥۖ حَمَّالَةُ اُ۬لْحَطَبِ ٤"
    },
    {
      "sura_no": 111,
      "aya_no": 5,
      "aya_text": "فِے جِيدِهَا حَبْلٞ مِّن مَّسَدِۢۖ ٥"
    }
  ],
  "page_text": "قُلْ يَٰأَيُّهَا اَ۬لْكَٰفِرُونَ ١ لَا أَعْبُدُ مَا تَعْبُدُونَ ٢ وَلَا أَنتُمْ عَٰبِدُونَ مَا أَعْبُدُۖ ٣ وَلَا أَنَا عَابِدٞ مَّا عَبَدتُّمْ ٤ وَلَا أَنتُمْ عَٰبِدُونَ مَا أَعْبُدُۖ ٥ لَكُمْ دِينُكُمْ وَلِيَ دِينِۖ ٦ إِذَا جَآءَ نَصْرُ اُ۬للَّهِ وَالْفَتْحُ ١ وَرَأَيْتَ اَ۬لنَّاسَ يَدْخُلُونَ فِے دِينِ اِ۬للَّهِ أَفْوَاجاٗ ٢ فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُۖ إِنَّهُۥ كَانَ تَوَّاباَۢۖ ٣ تَبَّتْ يَدَا أَبِے لَهَبٖ وَتَبَّۖ ١ مَا أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَۖ ٢ سَيَصْلَىٰ نَاراٗ ذَاتَ لَهَبٖ ٣ وَامْرَأَتُهُۥۖ حَمَّالَةُ اُ۬لْحَطَبِ ٤ فِے جِيدِهَا حَبْلٞ مِّن مَّسَدِۢۖ ٥"
}