  "surahs": [
    {
      "sura_no": 56,
      "sura_name_ar": "الوَاقِعة",
      "sura_name_en": "Al-Wāqi‘ah",
      "type": "meccan",
      "starts_here": false
    }
  ],
  "ayahs": [
    {
      "sura_no": 56,
      "aya_no": 19,
      "aya_text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ ١٩"
    },
    {
      "sura_no": 56,
      "aya_no": 20,
      "aya_text": "بِأَكْوَابٖ وَأَبَارِيقَ ٢٠"
    },
    {
      "sura_no": 56,
      "aya_no": 21,
      "aya_text": "وَكَأْسٖ مِّن مَّعِينٖ ٢١"
    },
    {
      "sura_no": 56,
      "aya_no": 22,
      "aya_text": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ ٢٢"
    },
    {
      "sura_no": 56,
      "aya_no": 23,
      "aya_text": "وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٣"
    },
    {
      "sura_no": 56,
      "aya_no": 24,
      "aya_text": "وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ ٢٤"
    },
    {
      "sura_no": 56,
      "aya_no": 25,
      "aya_text": "وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ ٢٥"
    },
    {
      "sura_no": 56,
      "aya_no": 26,
      "aya_text": "جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ ٢٦"
    },
    {
      "sura_no": 56,
      "aya_no": 27,
      "aya_text": "لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَأْثِيماًۖ ٢٧"
    },
    {
      "sura_no": 56,
      "aya_no": 28,
      "aya_text": "إِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ ٢٨"
    },
    {
      "sura_no": 56,
      "aya_no": 29,
      "aya_text": "وَأَصْحَٰبُ اُ۬لْيَمِينِ مَا أَصْحَٰبُ اُ۬لْيَمِينِۖ ٢٩"
    },
    {
      "sura_no": 56,
      "aya_no": 30,
      "aya_text": "فِے سِدْرٖ مَّخْضُودٖ ٣٠"
    },
    {
      "sura_no": 56,
      "aya_no": 31,
      "aya_text": "وَطَلْحٖ مَّنضُودٖ ٣١"
    },
    {
      "sura_no": 56,
      "aya_no": 32,
      "aya_text": "وَظِلّٖ مَّمْدُودٖ ٣٢"
    },
    {
      "sura_no": 56,
      "aya_no": 33,
      "aya_text": "وَمَآءٖ مَّسْكُوبٖ ٣٣"
    },
    {
      "sura_no": 56,
      "aya_no": 34,
      "aya_text": "وَفَٰكِهَةٖ كَثِيرَةٖ ٣٤"
    },
    {
      "sura_no": 56,
      "aya_no": 35,
      "aya_text": "لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ ٣٥"
    },
    {
      "sura_no": 56,
      "aya_no": 36,
      "aya_text": "وَفُرُشٖ مَّرْفُوعَةٍۖ ٣٦"
    },
    {
      "sura_no": 56,
      "aya_no": 37,
      "aya_text": "إِنَّا أَنشَأْنَٰهُنَّ إِنشَآءٗ ٣٧"
    },
    {
      "sura_no": 56,
      "aya_no": 38,
      "aya_text": "فَجَعَلْنَٰهُنَّ أَبْكَاراً ٣٨"
    },
    {
      "sura_no": 56,
      "aya_no": 39,
      "aya_text": "عُرُباً أَتْرَاباٗ ٣٩"
    },
    {
      "sura_no": 56,
      "aya_no": 40,
      "aya_text": "لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ ٤٠"
    },
    {
      "sura_no": 56,
      "aya_no": 41,
      "aya_text": "ثُلَّةٞ مِّنَ اَ۬لْأَوَّلِينَ ٤١"
    },
    {
      "sura_no": 56,
      "aya_no": 42,
      "aya_text": "وَثُلَّةٞ مِّنَ اَ۬لْأٓخِرِينَۖ ٤٢"
    },
    {
      "sura_no": 56,
      "aya_no": 43,
      "aya_text": "وَأَصْحَٰبُ اُ۬لشِّمَالِ ٤٣"
    },
    {
      "sura_no": 56,
      "aya_no": 44,
      "aya_text": "مَا أَصْحَٰبُ اُ۬لشِّمَالِۖ ٤٤"
    },
    {
      "sura_no": 56,
      "aya_no": 45,
      "aya_text": "فِے سَمُومٖ وَحَمِيمٖ ٤٥"
    },
    {
      "sura_no": 56,
      "aya_no": 46,
      "aya_text": "وَظِلّٖ مِّنْ يَّحْمُومٖ ٤٦"
    },
    {
      "sura_no": 56,
      "aya_no": 47,
      "aya_text": "لَّا بَارِدٖ وَلَا كَرِيمٍۖ ٤٧"
    },
    {
      "sura_no": 56,
      "aya_no": 48,
      "aya_text": "إِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ ٤٨"
    },
    {
      "sura_no": 56,
      "aya_no": 49,
      "aya_text": "وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ ٤٩"
    },
    {
      "sura_no": 56,
      "aya_no": 50,
      "aya_text": "وَكَانُواْ يَقُولُونَ أَٰئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ ٥٠"
    },
    {
      "sura_no": 56,
      "aya_no": 51,
      "aya_text": "أَوْ ءَابَآؤُنَا اَ۬لْأَوَّلُونَۖ ٥١"
    },
    {
      "sura_no": 56,
      "aya_no": 52,
      "aya_text": "۞ قُلْ إِنَّ اَ۬لْأَوَّلِينَ وَالْأٓخِرِينَ لَمَجْمُوعُونَ ٥٢"
    },
    {
      "sura_no": 56,
      "aya_no": 53,
      "aya_text": "إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ ٥٣"
    }
  ],
  "page_text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٞ مُّخَلَّدُونَ ١٩ بِأَكْوَابٖ وَأَبَارِيقَ ٢٠ وَكَأْسٖ مِّن مَّعِينٖ ٢١ لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزَفُونَ ٢٢ وَفَٰكِهَةٖ مِّمَّا يَتَخَيَّرُونَ ٢٣ وَلَحْمِ طَيْرٖ مِّمَّا يَشْتَهُونَۖ ٢٤ وَحُورٌ عِينٞ كَأَمْثَٰلِ اِ۬للُّؤْلُوِٕ اِ۬لْمَكْنُونِ ٢٥ جَزَآءَۢ بِمَا كَانُواْ يَعْمَلُونَۖ ٢٦ لَا يَسْمَعُونَ فِيهَا لَغْواٗ وَلَا تَأْثِيماًۖ ٢٧ إِلَّا قِيلاٗ سَلَٰماٗ سَلَٰماٗۖ ٢٨ وَأَصْحَٰبُ اُ۬لْيَمِينِ مَا أَصْحَٰبُ اُ۬لْيَمِينِۖ ٢٩ فِے سِدْرٖ مَّخْضُودٖ ٣٠ وَطَلْحٖ مَّنضُودٖ ٣١ وَظِلّٖ مَّمْدُودٖ ٣٢ وَمَآءٖ مَّسْكُوبٖ ٣٣ وَفَٰكِهَةٖ كَثِيرَةٖ ٣٤ لَّا مَقْطُوعَةٖ وَلَا مَمْنُوعَةٖ ٣٥ وَفُرُشٖ مَّرْفُوعَةٍۖ ٣٦ إِنَّا أَنشَأْنَٰهُنَّ إِنشَآءٗ ٣٧ فَجَعَلْنَٰهُنَّ أَبْكَاراً ٣٨ عُرُباً أَتْرَاباٗ ٣٩ لِّأَصْحَٰبِ اِ۬لْيَمِينِۖ ٤٠ ثُلَّةٞ مِّنَ اَ۬لْأَوَّلِينَ ٤١ وَثُلَّةٞ مِّنَ اَ۬لْأٓخِرِينَۖ ٤٢ وَأَصْحَٰبُ اُ۬لشِّمَالِ ٤٣ مَا أَصْحَٰبُ اُ۬لشِّمَالِۖ ٤٤ فِے سَمُومٖ وَحَمِيمٖ ٤٥ وَظِلّٖ مِّنْ يَّحْمُومٖ ٤٦ لَّا بَارِدٖ وَلَا كَرِيمٍۖ ٤٧ إِنَّهُمْ كَانُواْ قَبْلَ ذَٰلِكَ مُتْرَفِينَۖ ٤٨ وَكَانُواْ يُصِرُّونَ عَلَى اَ۬لْحِنثِ اِ۬لْعَظِيمِۖ ٤٩ وَكَانُواْ يَقُولُونَ أَٰئِذَا مِتْنَا وَكُنَّا تُرَاباٗ وَعِظَٰماً إِنَّا لَمَبْعُوثُونَ ٥٠ أَوْ ءَابَآؤُنَا اَ۬لْأَوَّلُونَۖ ٥١ ۞ قُلْ إِنَّ اَ۬لْأَوَّلِينَ وَالْأٓخِرِينَ لَمَجْمُوعُونَ ٥٢ إِلَىٰ مِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ ٥٣"
}