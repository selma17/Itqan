  ],
  "ayahs": [
    {
      "sura_no": 92,
      "aya_no": 10,
      "aya_text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰۖ ١٠"
    },
    {
      "sura_no": 92,
      "aya_no": 11,
      "aya_text": "وَمَا يُغْنِے عَنْهُ مَالُهُۥ إِذَا تَرَدَّىٰۖ ١١"
    },
    {
      "sura_no": 92,
      "aya_no": 12,
      "aya_text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ ١٢"
    },
    {
      "sura_no": 92,
      "aya_no": 13,
      "aya_text": "وَإِنَّ لَنَا لَلْأٓخِرَةَ وَالْأُولَىٰۖ ١٣"
    },
    {
      "sura_no": 92,
      "aya_no": 14,
      "aya_text": "فَأَنذَرْتُكُمْ نَاراٗ تَلَظَّىٰ ١٤"
    },
    {
      "sura_no": 92,
      "aya_no": 15,
      "aya_text": "لَا يَصْلَيٰهَا إِلَّا اَ۬لْأَشْقَى ١٥"
    },
    {
      "sura_no": 92,
      "aya_no": 16,
      "aya_text": "اَ۬لذِے كَذَّبَ وَتَوَلَّىٰۖ ١٦"
    },
    {
      "sura_no": 92,
      "aya_no": 17,
      "aya_text": "وَسَيُجَنَّبُهَا اَ۬لْأَتْقَى ١٧"
    },
    {
      "sura_no": 92,
      "aya_no": 18,
      "aya_text": "اَ۬لذِے يُؤْتِے مَالَهُۥ يَتَزَكَّىٰۖ ١٨"
    },
    {
      "sura_no": 92,
      "aya_no": 19,
      "aya_text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْزَىٰ ١٩"
    },
    {
      "sura_no": 92,
      "aya_no": 20,
      "aya_text": "إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لْأَعْلَىٰۖ ٢٠"
    },
    {
      "sura_no": 92,
      "aya_no": 21,
      "aya_text": "وَلَسَوْفَ يَرْضَىٰۖ ٢١"
    },
    {
      "sura_no": 93,
      "aya_no": 1,
      "aya_text": "وَالضُّحَىٰ ١"
    },
    {
      "sura_no": 93,
      "aya_no": 2,
      "aya_text": "وَاليْلِ إِذَا سَجَىٰ ٢"
    },
    {
      "sura_no": 93,
      "aya_no": 3,
      "aya_text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰۖ ٣"
    },
    {
      "sura_no": 93,
      "aya_no": 4,
      "aya_text": "وَلَلْأٓخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لْأُولَىٰۖ ٤"
    },
    {
      "sura_no": 93,
      "aya_no": 5,
      "aya_text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰۖ ٥"
    },
    {
      "sura_no": 93,
      "aya_no": 6,
      "aya_text": "أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاوَىٰ ٦"
    },
    {
      "sura_no": 93,
      "aya_no": 7,
      "aya_text": "وَوَجَدَكَ ضَآلّاٗ فَهَدَىٰ ٧"
    },
    {
      "sura_no": 93,
      "aya_no": 8,
      "aya_text": "وَوَجَدَكَ عَآئِلاٗ فَأَغْنَىٰۖ ٨"
    },
    {
      "sura_no": 93,
      "aya_no": 9,
      "aya_text": "فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ ٩"
    },
    {
      "sura_no": 93,
      "aya_no": 10,
      "aya_text": "وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ ١٠"
    },
    {
      "sura_no": 93,
      "aya_no": 11,
      "aya_text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْۖ ١١"
    },
    {
      "sura_no": 94,
      "aya_no": 1,
      "aya_text": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ١"
    },
    {
      "sura_no": 94,
      "aya_no": 2,
      "aya_text": "وَوَضَعْنَا عَنكَ وِزْرَكَ ٢"
    }
  ],
  "page_text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰۖ ١٠ وَمَا يُغْنِے عَنْهُ مَالُهُۥ إِذَا تَرَدَّىٰۖ ١١ إِنَّ عَلَيْنَا لَلْهُدَىٰ ١٢ وَإِنَّ لَنَا لَلْأٓخِرَةَ وَالْأُولَىٰۖ ١٣ فَأَنذَرْتُكُمْ نَاراٗ تَلَظَّىٰ ١٤ لَا يَصْلَيٰهَا إِلَّا اَ۬لْأَشْقَى ١٥ اَ۬لذِے كَذَّبَ وَتَوَلَّىٰۖ ١٦ وَسَيُجَنَّبُهَا اَ۬لْأَتْقَى ١٧ اَ۬لذِے يُؤْتِے مَالَهُۥ يَتَزَكَّىٰۖ ١٨ وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْزَىٰ ١٩ إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لْأَعْلَىٰۖ ٢٠ وَلَسَوْفَ يَرْضَىٰۖ ٢١ وَالضُّحَىٰ ١ وَاليْلِ إِذَا سَجَىٰ ٢ مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰۖ ٣ وَلَلْأٓخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لْأُولَىٰۖ ٤ وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰۖ ٥ أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاوَىٰ ٦ وَوَجَدَكَ ضَآلّاٗ فَهَدَىٰ ٧ وَوَجَدَكَ عَآئِلاٗ فَأَغْنَىٰۖ ٨ فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ ٩ وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ ١٠ وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْۖ ١١ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ١ وَوَضَعْنَا عَنكَ وِزْرَكَ ٢"
}