  ],
  "ayahs": [
    {
      "sura_no": 94,
      "aya_no": 3,
      "aya_text": "اَ۬لذِے أَنقَضَ ظَهْرَكَ ٣"
    },
    {
      "sura_no": 94,
      "aya_no": 4,
      "aya_text": "وَرَفَعْنَا لَكَ ذِكْرَكَۖ ٤"
    },
    {
      "sura_no": 94,
      "aya_no": 5,
      "aya_text": "فَإِنَّ مَعَ اَ۬لْعُسْرِ يُسْراً ٥"
    },
    {
      "sura_no": 94,
      "aya_no": 6,
      "aya_text": "إِنَّ مَعَ اَ۬لْعُسْرِ يُسْراٗۖ ٦"
    },
    {
      "sura_no": 94,
      "aya_no": 7,
      "aya_text": "فَإِذَا فَرَغْتَ فَانصَبْ ٧"
    },
    {
      "sura_no": 94,
      "aya_no": 8,
      "aya_text": "وَإِلَىٰ رَبِّكَ فَارْغَبۖ ٨"
    },
    {
      "sura_no": 95,
      "aya_no": 1,
      "aya_text": "وَالتِّينِ وَالزَّيْتُونِ ١"
    },
    {
      "sura_no": 95,
      "aya_no": 2,
      "aya_text": "وَطُورِ سِينِينَ ٢"
    },
    {
      "sura_no": 95,
      "aya_no": 3,
      "aya_text": "وَهَٰذَا اَ۬لْبَلَدِ اِ۬لْأَمِينِ ٣"
    },
    {
      "sura_no": 95,
      "aya_no": 4,
      "aya_text": "لَقَدْ خَلَقْنَا اَ۬لْإِنسَٰنَ فِے أَحْسَنِ تَقْوِيمٖ ٤"
    },
    {
      "sura_no": 95,
      "aya_no": 5,
      "aya_text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ ٥"
    },
    {
      "sura_no": 95,
      "aya_no": 6,
      "aya_text": "إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٖۖ ٦"
    },
    {
      "sura_no": 95,
      "aya_no": 7,
      "aya_text": "فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ ٧"
    },
    {
      "sura_no": 95,
      "aya_no": 8,
      "aya_text": "أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ ٨"
    },
    {
      "sura_no": 96,
      "aya_no": 1,
      "aya_text": "اِ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ ١"
    },
    {
      "sura_no": 96,
      "aya_no": 2,
      "aya_text": "خَلَقَ اَ۬لْإِنسَٰنَ مِنْ عَلَقٍۖ ٢"
    },
    {
      "sura_no": 96,
      "aya_no": 3,
      "aya_text": "اِ۪قْرَأْ وَرَبُّكَ اَ۬لْأَكْرَمُ ٣"
    },
    {
      "sura_no": 96,
      "aya_no": 4,
      "aya_text": "اُ۬لذِے عَلَّمَ بِالْقَلَمِ ٤"
    },
    {
      "sura_no": 96,
      "aya_no": 5,
      "aya_text": "عَلَّمَ اَ۬لْإِنسَٰنَ مَا لَمْ يَعْلَمْۖ ٥"
    },
    {
      "sura_no": 96,
      "aya_no": 6,
      "aya_text": "كَلَّا إِنَّ اَ۬لْإِنسَٰنَ لَيَطْغَىٰ ٦"
    },
    {
      "sura_no": 96,
      "aya_no": 7,
      "aya_text": "أَن رَّءَاهُ اُ۪سْتَغْنَىٰۖ ٧"
    },
    {
      "sura_no": 96,
      "aya_no": 8,
      "aya_text": "إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْعَىٰۖ ٨"
    },
    {
      "sura_no": 96,
      "aya_no": 9,
      "aya_text": "أَرَٰ۬يْتَ اَ۬لذِے يَنْهَىٰ ٩"
    },
    {
      "sura_no": 96,
      "aya_no": 10,
      "aya_text": "عَبْداً إِذَا صَلَّىٰۖ ١٠"
    },
    {
      "sura_no": 96,
      "aya_no": 11,
      "aya_text": "أَرَٰ۬يْتَ إِن كَانَ عَلَى اَ۬لْهُدَىٰ ١١"
    },
    {
      "sura_no": 96,
      "aya_no": 12,
      "aya_text": "أَوْ أَمَرَ بِالتَّقْوَىٰ ١٢"
    }
  ],
  "page_text": "اَ۬لذِے أَنقَضَ ظَهْرَكَ ٣ وَرَفَعْنَا لَكَ ذِكْرَكَۖ ٤ فَإِنَّ مَعَ اَ۬لْعُسْرِ يُسْراً ٥ إِنَّ مَعَ اَ۬لْعُسْرِ يُسْراٗۖ ٦ فَإِذَا فَرَغْتَ فَانصَبْ ٧ وَإِلَىٰ رَبِّكَ فَارْغَبۖ ٨ وَالتِّينِ وَالزَّيْتُونِ ١ وَطُورِ سِينِينَ ٢ وَهَٰذَا اَ۬لْبَلَدِ اِ۬لْأَمِينِ ٣ لَقَدْ خَلَقْنَا اَ۬لْإِنسَٰنَ فِے أَحْسَنِ تَقْوِيمٖ ٤ ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ ٥ إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٖۖ ٦ فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ ٧ أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ ٨ اِ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ ١ خَلَقَ اَ۬لْإِنسَٰنَ مِنْ عَلَقٍۖ ٢ اِ۪قْرَأْ وَرَبُّكَ اَ۬لْأَكْرَمُ ٣ اُ۬لذِے عَلَّمَ بِالْقَلَمِ ٤ عَلَّمَ اَ۬لْإِنسَٰنَ مَا لَمْ يَعْلَمْۖ ٥ كَلَّا إِنَّ اَ۬لْإِنسَٰنَ لَيَطْغَىٰ ٦ أَن رَّءَاهُ اُ۪سْتَغْنَىٰۖ ٧ إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْعَىٰۖ ٨ أَرَٰ۬يْتَ اَ۬لذِے يَنْهَىٰ ٩ عَبْداً إِذَا صَلَّىٰۖ ١٠ أَرَٰ۬يْتَ إِن كَانَ عَلَى اَ۬لْهُدَىٰ ١١ أَوْ أَمَرَ بِالتَّقْوَىٰ ١٢"
}