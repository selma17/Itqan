{
  "page": 602,
  "lines": [
    { "l": 1, "t": "header", "v": "قُرَيش" },
    { "l": 2, "t": "bismillah"},
    { "l": 3, "t": "text", "v": "ِإِيلَٰفِ قُرَيْشٍ ١ إِيلَٰفِهِمْ رِحْلَةَ اَ۬لشِّتَآءِ وَالصَّيْفِۖ" },
    { "l": 4, "t": "text", "v": "فَلْيَعْبُدُواْ رَبَّ هَٰذَا اَ۬لْبَيْتِ ٣ اِ۬لذِے أَطْعَمَهُم" },
    { "l": 5, "t": "text", "v": "ِّن جُوعٖ ٤ وَءَامَنَهُم مِّنْ خَوْفِۢۖ ٥" },
    { "l": 6, "t": "header", "v": "المَاعُون" },
    { "l": 7, "t": "bismillah"},
    { "l": 8, "t": "text", "v": "َرَٰ۬يْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ ١ فَذَٰلِكَ اَ۬لذِے" },
    { "l": 9, "t": "text", "v": "َدُعُّ اُ۬لْيَتِيمَ ٢ وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ ٣" },
    { "l": 10, "t": "text", "v": "فَوَيْلٞ لِّلْمُصَلِّينَ ٤ اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ" },
    { "l": 11, "t": "text", "v": "٥ اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ ٦" },
    { "l": 12, "t": "header", "v": "الكَوثر" },
    { "l": 13, "t": "bismillah"},
    { "l": 14, "t": "text", "v": "إِنَّا أَعْطَيْنَٰكَ اَ۬لْكَوْثَرَ ١ فَصَلِّ لِرَبِّكَ وَانْحَرْۖ ٢" },
    { "l": 15, "t": "text", "v": "نَّ شَانِئَكَ هُوَ اَ۬لْأَبْتَرُۖ ٣" }
  ]
}